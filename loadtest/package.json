{
  "name": "nutfes-bingo-loadtest",
  "version": "1.0.0",
  "description": "BINGO アプリケーション用の包括的な負荷試験スイート",
  "main": "run-tests.sh",
  "scripts": {
    "test": "./run-tests.sh",
    "test:websocket": "./run-tests.sh websocket",
    "test:http": "./run-tests.sh http",
    "test:artillery": "./run-tests.sh artillery",
    "test:all": "./run-tests.sh all",
    "analyze": "./analyze-results.sh",
    "analyze:evaluate": "./analyze-results.sh evaluate",
    "analyze:list": "./analyze-results.sh list",
    "clean": "./analyze-results.sh cleanup",
    "install-deps": "npm install -g artillery && echo 'K6をインストールしてください: https://k6.io/docs/getting-started/installation/'"
  },
  "keywords": [
    "load-testing",
    "performance",
    "k6",
    "artillery",
    "websocket",
    "graphql",
    "hasura",
    "nextjs",
    "bingo"
  ],
  "author": "NUT Festival Team",
  "license": "MIT",
  "devDependencies": {
    "artillery": "^2.0.0",
    "js-yaml": "^4.1.0"
  },
  "engines": {
    "node": ">=16.0.0"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/NUTFes/nutfes-Bingo.git",
    "directory": "loadtest"
  },
  "bugs": {
    "url": "https://github.com/NUTFes/nutfes-Bingo/issues"
  },
  "homepage": "https://github.com/NUTFes/nutfes-Bingo/tree/main/loadtest#readme"
