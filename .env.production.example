# Public URL served by Cloudflare. Do not include a trailing slash.
NEXT_PUBLIC_SITE_URL=https://bingo.example.com

# Browser-facing Supabase URL. Caddy strips /supabase before forwarding to Kong.
NEXT_PUBLIC_SUPABASE_URL=https://bingo.example.com/supabase
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=your-publishable-or-anon-key

# Server-side Supabase URL used from the Next.js container.
SUPABASE_SERVER_URL=http://caddy:8080/supabase

# Docker network and service name for the self-hosted Supabase Kong container.
# Adjust these to match the production Supabase compose project.
SUPABASE_DOCKER_NETWORK=supabase_default
SUPABASE_KONG_HOST=kong
SUPABASE_KONG_PORT=8000

# Remotely-managed Cloudflare Tunnel token.
# Configure the tunnel public hostname service as: http://caddy:8080
CLOUDFLARE_TUNNEL_TOKEN=replace-with-cloudflare-tunnel-token

# Optional image tag for the built Next.js app image.
APP_IMAGE_TAG=latest
