# Production is fixed to Proxmox LXC + Cloudflare Tunnel.
# Configure Cloudflare Public Hostnames to forward:
# - app.example.com -> http://app:3000
# - supabase.example.com -> http://kong:8000

# Browser-facing URLs. Do not include a trailing slash.
NEXT_PUBLIC_SITE_URL=https://app.example.com
NEXT_PUBLIC_SUPABASE_URL=https://supabase.example.com

# Supabase self-hosted public URLs. These should match the browser-facing URLs.
SITE_URL=https://app.example.com
SUPABASE_PUBLIC_URL=https://supabase.example.com
API_EXTERNAL_URL=https://supabase.example.com

# Application
APP_IMAGE_TAG=2026-06-09
NEXT_PUBLIC_ENABLE_ADMIN_SIGNUP=0
NUTFES_PUBLIC_ACTION_HASH_SALT=replace-with-generated-random-value

# PostgreSQL and Supabase Auth
POSTGRES_PASSWORD=replace-with-generated-postgres-password
JWT_SECRET=replace-with-generated-jwt-secret
JWT_EXPIRY=3600
ANON_KEY=replace-with-generated-legacy-anon-key
SERVICE_ROLE_KEY=replace-with-generated-legacy-service-role-key

# Asymmetric JWT signing and opaque API keys.
# Generate these with: mise run prod:env:init
SUPABASE_PUBLISHABLE_KEY=replace-with-generated-publishable-key
SUPABASE_SECRET_KEY=replace-with-generated-secret-key
ANON_KEY_ASYMMETRIC=replace-with-generated-asymmetric-anon-key
SERVICE_ROLE_KEY_ASYMMETRIC=replace-with-generated-asymmetric-service-role-key
JWT_KEYS=[]
JWT_JWKS={"keys":[]}

# Auth is closed by default. Temporarily set both values only during planned
# administrator account creation, then restore true / 0 and recreate auth/app.
DISABLE_SIGNUP=true
ENABLE_EMAIL_AUTOCONFIRM=true
ADDITIONAL_REDIRECT_URLS=https://app.example.com/**

# PostgREST and Storage
PGRST_DB_SCHEMAS=public,storage
PGRST_DB_MAX_ROWS=1000
KONG_NGINX_WORKER_PROCESSES=1
STORAGE_FILE_SIZE_LIMIT=5242880
GLOBAL_S3_BUCKET=stub
STORAGE_TENANT_ID=nutfes-bingo
REGION=local
S3_PROTOCOL_ACCESS_KEY_ID=replace-with-generated-s3-access-key-id
S3_PROTOCOL_ACCESS_KEY_SECRET=replace-with-generated-s3-access-key-secret

# Persist production data outside the Git checkout.
SUPABASE_DB_DATA_PATH=/srv/nutfes-bingo/postgres
SUPABASE_STORAGE_DATA_PATH=/srv/nutfes-bingo/storage

# Cloudflare Tunnel
CLOUDFLARE_TUNNEL_TOKEN=
CLOUDFLARED_IMAGE=cloudflare/cloudflared:2026.5.0
