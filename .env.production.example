# Copy to .env.production.local for non-secret defaults, then fill real Supabase values.
# Do not store CLOUDFLARED_TUNNEL_TOKEN in this file; export it in the shell or use an
# outside-repository secret file only for the current deployment session.

NEXT_PUBLIC_SUPABASE_URL=https://bingo-stg.nutfes.net/supabase
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_xxx

# Internal self-hosted Supabase Kong URL used by server-side code.
SUPABASE_SERVER_URL=http://supabase_kong_nutfes-Bingo:8000
SUPABASE_SECRET_KEY=sb_secret_xxx
SUPABASE_SERVICE_ROLE_KEY=

# Caddy proxies /supabase/* to this upstream and strips the /supabase prefix.
SUPABASE_UPSTREAM=supabase_kong_nutfes-Bingo:8000
SUPABASE_DOCKER_NETWORK=supabase_network_nutfes-Bingo
EXTERNAL_SCHEME=https

ENABLE_ADMIN_SIGNUP=0
NUTFES_SKIP_SUPABASE_FETCH=0
