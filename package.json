{
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite",
    "dev:reset": "node scripts/reset-local.mjs",
    "build": "vite build",
    "build:preview": "pnpm config:validate preview && CLOUDFLARE_ENV=preview vite build",
    "build:personal": "pnpm config:validate personal && CLOUDFLARE_ENV=personal vite build",
    "build:production": "pnpm config:validate production && CLOUDFLARE_ENV=production vite build",
    "preview": "vite preview",
    "deploy": "pnpm build:production && wrangler deploy --env production",
    "deploy:preview": "pnpm build:preview && wrangler deploy --env preview",
    "deploy:personal": "pnpm build:personal && wrangler deploy --env personal",
    "config:validate": "node scripts/validate-deploy-config.mjs",
    "typecheck": "tsc --noEmit",
    "types": "wrangler types",
    "check": "pnpm versions:check && pnpm fmt:check && pnpm lint && pnpm typecheck && pnpm test",
    "test": "vitest run",
    "test:unit": "vitest run test/unit",
    "test:integration": "vitest run test/integration",
    "test:e2e": "vitest run test/integration/e2e.test.ts",
    "test:load": "node test/load/websocket-load.mjs",
    "test:smoke": "node scripts/smoke-test.mjs",
    "lint": "oxlint",
    "lint:fix": "oxlint --fix",
    "format": "oxfmt",
    "fmt": "oxfmt",
    "fmt:check": "oxfmt --check",
    "secrets:check": "node scripts/check-secrets.mjs",
    "versions:check": "node scripts/check-tool-versions.mjs",
    "doctor": "react-doctor --yes --no-score --project . --scope files --base origin/main --verbose --blocking none",
    "knip": "knip"
  },
  "dependencies": {
    "jose": "^6.2.3",
    "matter-js": "0.20.0",
    "react": "19.2.7",
    "react-dom": "19.2.7",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@cloudflare/vite-plugin": "^1.43.0",
    "@cloudflare/vitest-pool-workers": "^0.18.0",
    "@types/matter-js": "0.20.2",
    "@types/node": "26.1.0",
    "@types/react": "19.2.15",
    "@types/react-dom": "19.2.3",
    "@types/ws": "^8.18.1",
    "@vitejs/plugin-react": "^6.0.3",
    "knip": "6.14.1",
    "oxfmt": "0.40.0",
    "oxlint": "1.55.0",
    "react-doctor": "0.5.6",
    "typescript": "5.9.3",
    "vite": "^8.1.3",
    "vitest": "^4.1.9",
    "wrangler": "^4.107.0",
    "ws": "^8.21.0"
  },
  "engines": {
    "node": "26.2.0",
    "pnpm": "11.2.2"
  },
  "packageManager": "pnpm@11.2.2"
}
