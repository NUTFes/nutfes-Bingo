{
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "typecheck": "tsc --noEmit",
    "check": "pnpm versions:check && pnpm fmt:check && pnpm lint && pnpm typecheck",
    "lint": "oxlint",
    "lint:fix": "oxlint --fix",
    "fmt": "oxfmt",
    "test": "CLOUDFLARE_LOAD_DEV_VARS_FROM_DOT_ENV=false TURNSTILE_SECRET_KEY=test-turnstile-secret vitest run",
    "test:watch": "CLOUDFLARE_LOAD_DEV_VARS_FROM_DOT_ENV=false TURNSTILE_SECRET_KEY=test-turnstile-secret vitest",
    "load:cloudflare": "node scripts/cloudflare-load-test.mjs",
    "worker:types": "wrangler types --strict-vars=false",
    "worker:types:check": "wrangler types --strict-vars=false --check",
    "worker:dry-run": "wrangler deploy --env='' --dry-run --minify --outdir .wrangler-dist",
    "worker:bundle:check": "node scripts/check-worker-bundle-size.mjs .wrangler-dist",
    "fmt:check": "oxfmt --check",
    "secrets:check": "node scripts/check-secrets.mjs",
    "versions:check": "node scripts/check-tool-versions.mjs",
    "doctor": "react-doctor --yes --no-score --project . --scope files --base origin/develop --verbose --blocking none",
    "knip": "knip"
  },
  "dependencies": {
    "clsx": "2.1.1",
    "driver.js": "1.4.0",
    "jose": "6.2.3",
    "lucide-react": "0.511.0",
    "matter-js": "0.20.0",
    "react": "19.2.7",
    "react-aria": "3.47.0",
    "react-aria-components": "1.16.0",
    "react-dom": "19.2.7",
    "tailwind-merge": "3.5.0",
    "tailwind-variants": "3.2.2",
    "tailwindcss-react-aria-components": "2.1.0"
  },
  "devDependencies": {
    "@cloudflare/vite-plugin": "1.52.0",
    "@cloudflare/vitest-pool-workers": "0.21.3",
    "@fontsource/rajdhani": "^5.3.0",
    "@tailwindcss/vite": "4.3.3",
    "@types/matter-js": "0.20.2",
    "@types/node": "26.1.0",
    "@types/react": "19.2.15",
    "@types/react-dom": "19.2.3",
    "@vitejs/plugin-react": "^6.1.0",
    "knip": "6.14.1",
    "oxfmt": "0.40.0",
    "oxlint": "1.55.0",
    "react-doctor": "0.9.12",
    "tailwindcss": "4.3.3",
    "tailwindcss-animate": "1.0.7",
    "typescript": "5.9.3",
    "vite": "^8.2.2",
    "vitest": "4.1.10",
    "wrangler": "4.123.0"
  },
  "engines": {
    "node": "26.2.0",
    "pnpm": "11.2.2"
  },
  "packageManager": "pnpm@11.2.2"
}
