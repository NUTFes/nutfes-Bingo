# Local Docker development uses the Supabase CLI local stack. `mise run dev`
# reads local anon/service keys from `supabase status`, so these values are
# mainly for running pnpm commands directly on the host.
NEXT_PUBLIC_SUPABASE_URL=https://nutfes-bingo.localhost/supabase
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=your-publishable-or-anon-key
NEXT_PUBLIC_SITE_URL=https://nutfes-bingo.localhost

# Optional. Server-side Supabase URL. In Docker development this can stay unset
# because the app connects through https://nutfes-bingo.localhost/supabase.

# Server-only key used by public Server Actions for controlled DB writes.
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# Optional server-only salt for hashing public client cookies before DB storage.
NUTFES_PUBLIC_ACTION_HASH_SALT=replace-with-random-secret

# Local development can keep signup enabled. Production defaults to disabled unless this is 1.
NEXT_PUBLIC_ENABLE_ADMIN_SIGNUP=1
