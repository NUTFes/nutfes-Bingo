# Update these with your Supabase details from your project settings > API
# https://app.supabase.com/project/_/settings/api
NEXT_PUBLIC_SUPABASE_URL=https://nutfes-bingo.localhost/supabase
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=your-publishable-or-anon-key
NEXT_PUBLIC_SITE_URL=https://nutfes-bingo.localhost

# Optional. Server-side Supabase URL. In local Docker development this can stay unset.
# In production Docker, set this to the internal Caddy URL, for example:
# SUPABASE_SERVER_URL=http://caddy:8080/supabase
