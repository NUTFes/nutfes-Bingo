# Local Docker development uses the Supabase CLI local stack. `mise run up`
# reads local anon/service keys from `supabase status` and passes them to
# Compose, so normal development does not require editing the Supabase keys here.
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Optional. Server-side Supabase URL. Docker development points from the app
# container to the Supabase CLI Kong container on the shared Docker network.
SUPABASE_SERVER_URL=http://supabase_kong_nutfes-Bingo:8000
SUPABASE_PUBLISHABLE_KEY=your-publishable-or-anon-key

# Server-only key used by public Server Actions for controlled DB writes.
SUPABASE_SECRET_KEY=your-service-role-or-secret-key

# Optional server-only salt for hashing public client cookies before DB storage.
NUTFES_PUBLIC_ACTION_HASH_SALT=replace-with-random-secret
