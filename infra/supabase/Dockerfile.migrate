FROM node:26.2.0-alpine

ENV COREPACK_ENABLE_DOWNLOAD_PROMPT=0

WORKDIR /tool

RUN npm install --global pnpm@11.2.2 \
  && printf '{"private":true,"dependencies":{"supabase":"2.105.0"}}\n' > package.json \
  && pnpm install --prod --lockfile=false \
  && pnpm store prune \
  && npm cache clean --force

WORKDIR /workspace
