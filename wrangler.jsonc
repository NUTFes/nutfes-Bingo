{
  "$schema": "./node_modules/wrangler/config-schema.json",
  // scripts/cloudflare-wrangler.sh pins every CLI call to the organization account.
  "name": "nutfes-bingo",
  "main": "./worker/index.ts",
  // Custom domains are configured out-of-band. Never expose an Access/WAF-bypassing workers.dev URL.
  "workers_dev": false,
  "preview_urls": false,
  // Latest compatibility date supported by the pinned workerd in the test pool.
  "compatibility_date": "2026-08-11",

  // Vite owns the generated assets directory. Public assets bypass the Worker while
  // dynamic APIs and the Access-protected admin/screen trees invoke it first.
  "assets": {
    "binding": "ASSETS",
    "not_found_handling": "single-page-application",
    "run_worker_first": ["/api/*", "/admin*", "/screen", "/screen/*"],
  },

  "durable_objects": {
    "bindings": [
      { "name": "GAME_STATE", "class_name": "GameState" },
      { "name": "REACTION_HUB", "class_name": "ReactionHub" },
    ],
  },
  "migrations": [
    {
      "tag": "v1",
      "new_sqlite_classes": ["GameState", "ReactionHub"],
    },
  ],

  "r2_buckets": [
    {
      "binding": "PRIZE_IMAGES",
      "bucket_name": "nutfes-bingo-prize-images",
    },
  ],

  // Empty Access settings deliberately fail closed. Supply reviewed values at deploy.
  // None of these values are secrets; authentication still requires a signed Access JWT.
  "vars": {
    "ACCESS_TEAM_DOMAIN": "",
    "ACCESS_AUD": "",
    "ADMIN_EMAILS": "[]",
    "SCREEN_ACCESS_AUD": "",
    "SCREEN_EMAILS": "[]",
    "RELEASE_SHA": "",
    "MEDIA_ORIGIN": "",
    "LOCAL_ADMIN_BYPASS": "false",
    "LOCAL_SCREEN_BYPASS": "false",
    "LOCAL_TURNSTILE_TEST_MODE": "false",
    "STAMP_DAILY_LIMIT": "25000",
    "TURNSTILE_HOSTNAME": "",
  },
  "secrets": { "required": ["TURNSTILE_SECRET_KEY"] },

  "observability": {
    "enabled": true,
    "logs": {
      "enabled": true,
      "head_sampling_rate": 1,
      "invocation_logs": false,
    },
    "traces": { "enabled": true, "head_sampling_rate": 0.01 },
  },
}
