{$CADDY_SITE_ADDRESS::8080} {
	encode zstd gzip

	log {
		output stdout
		format console
	}

	header {
		-Server
		X-Content-Type-Options "nosniff"
		Referrer-Policy "strict-origin-when-cross-origin"
		Permissions-Policy "camera=(), microphone=(), geolocation=(), payment=()"
	}

	request_body {
		max_size {$CADDY_MAX_REQUEST_BODY:8MB}
	}

	@supabase_auth_admin path /supabase/auth/v1/admin/*
	handle @supabase_auth_admin {
		respond "Not Found" 404
	}

	@supabase_auth path /supabase/auth/v1/*
	handle @supabase_auth {
		uri strip_prefix /supabase
		reverse_proxy kong:8000
	}

	handle /supabase/* {
		respond "Not Found" 404
	}

	handle {
		reverse_proxy app:3000
	}
}
